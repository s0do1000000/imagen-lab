# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                   # SECRET — server only, never NEXT_PUBLIC_

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Public URL of the deployed Mini App (used as the WebApp button target)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Google Cloud — service account with the "Vertex AI User" (Agent Platform User) role,
# JSON key as ONE LINE of text (paste the whole downloaded .json content here).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# TON wallet address to receive USDT payments (public address only — no
# private key needed here). Get one from Tonkeeper, MyTonWallet, or @wallet.
TON_WALLET_ADDRESS=
# Free API key from https://tonconsole.com — needed to check USDT payments
# via TonAPI (unlike the earlier TonCenter-based check, this one requires it).
TONAPI_KEY=

# Your own Telegram numeric user ID (message @userinfobot to get it).
# Enables the /credit admin command — a manual fallback for crediting a
# purchase if the automatic USDT payment check ever misses a real payment.
TELEGRAM_ADMIN_ID=
